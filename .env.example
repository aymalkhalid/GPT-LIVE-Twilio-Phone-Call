# Copy to .env for a new setup; keep any existing .env and its credentials.
OPENAI_API_KEY=
TWILIO_AUTH_TOKEN=

# Fill this in after starting an HTTPS tunnel, then restart the server.
# Use the origin only, without /incoming-call or a trailing path.
PUBLIC_BASE_URL=https://your-actual-tunnel.ngrok-free.app

# Separate settings prevent an existing generic OPENAI_MODEL from selecting
# the wrong model for the Live protocol. These preserve the Twilio tutorial.
LIVE_MODEL=gpt-live-1
DELEGATED_MODEL=gpt-5.6-terra
VOICE=marin
ENABLE_WEB_SEARCH=true

# Bounds for network startup, graceful finalization, and the fake tool.
STARTUP_TIMEOUT_SECONDS=15
CLOSE_TIMEOUT_SECONDS=5
TOOL_DELAY_SECONDS=2
